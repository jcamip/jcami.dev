# Resend API key used by src/app/api/contact/route.ts (contact-form
# submissions to hello@jcami.dev) and src/app/api/subscribe/route.ts
# (creative pool signups to daniel@jcami.dev). Get one at
# https://resend.com/api-keys after verifying jcami.dev under
# https://resend.com/domains.
RESEND_API_KEY=

# Absolute canonical origin. Use the public HTTPS origin with no path or
# trailing slash. Production falls back to https://jcami.dev and will never
# emit localhost canonical URLs.
NEXT_PUBLIC_SITE_URL=https://jcami.dev

# Optional ownership tokens from the corresponding webmaster tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
